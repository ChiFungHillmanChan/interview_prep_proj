# Never upload these to Vercel, even when deploying from a local machine.
# `.vercelignore` replaces `.gitignore` for CLI deploys, so untracked local
# files (personal CVs, the dev database) must be listed explicitly.

env/
venv/
.venv/
output/
docs/

# Local database and logs — production uses Postgres via DATABASE_URL.
**/db.sqlite3
**/db.sqlite3-journal
**/*.log

# Personal documents. These are gitignored, but a CLI deploy would otherwise
# pick them up from the working directory.
**/ChiFungHillmanChan.*

# Regenerated by Vercel's automatic collectstatic.
**/staticfiles/

__pycache__/
*.py[cod]
.DS_Store
**/.DS_Store
