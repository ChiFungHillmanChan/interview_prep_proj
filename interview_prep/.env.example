# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
DATABASE_URL=

# Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key
INTERVIEW_COACH_USE_AI=False
CAREER_MEMORY_USE_AI=False
INTERVIEW_COACH_MODEL=gemini-2.5-flash-lite

# Email (SMTP) — used for password reset
HOST_EMAIL=your-email@example.com
HOST_PASSWORD=your-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=AceInterview <noreply@example.com>

# Optional Google sign-in
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
