# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# On Vercel these are Project Environment Variables instead of a file.
# `python-decouple` reads os.environ before any .env, so the same names work
# unchanged in both places. Pull the deployed set locally with `vercel env pull`.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False

# Required in every deployed environment. Provisioned automatically by the
# Neon integration on Vercel; leave blank locally to fall back to SQLite.
DATABASE_URL=

# Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key
INTERVIEW_COACH_USE_AI=False
CAREER_MEMORY_USE_AI=False
INTERVIEW_COACH_MODEL=gemini-2.5-flash-lite

# Email (SMTP) — used for password reset.
# Vercel blocks port 25 only, so 587 works, but a transactional email API is
# faster and more reliable than holding an SMTP handshake open in a function.
HOST_EMAIL=your-email@example.com
HOST_PASSWORD=your-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=AceInterview <noreply@example.com>

# Optional Google sign-in. The redirect URI must match the deployed domain.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
